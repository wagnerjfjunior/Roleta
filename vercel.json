{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if git diff --name-only HEAD^ HEAD | grep -Ev '^(docs/|handoffs/|bootstrap/|\\.sfjm/|\\.github/|README\\.md$)' | grep -q .; then exit 1; else exit 0; fi",
  "headers": [
    {
      "source": "/data/events.csv",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/roleta-ocr.js": {
      "maxDuration": 200
    },
    "api/final-roulette.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/ocr-job-submit",
      "destination": "/api/ocr-shadow-submit?__intake=submit"
    },
    {
      "source": "/api/ocr-job-status",
      "destination": "/api/ocr-shadow-submit?__intake=status"
    },
    {
      "source": "/api/ocr-callback",
      "destination": "/api/ocr-shadow-submit?__intake=callback"
    }
  ]
}
