{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if git diff --name-only HEAD^ HEAD | grep -Ev '^(docs/|handoffs/|bootstrap/|\\.sfjm/|\\.github/|README\\.md$)' | grep -q .; then exit 1; else exit 0; fi",
  "headers": [
    {
      "source": "/data/events.csv",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},
        {"key":"Content-Type","value":"text/csv; charset=utf-8"}
      ]
    }
  ]
}
